# stir — App Store automation
#
# Auth: create an App Store Connect API key (Users and Access → Integrations)
# and set these in fastlane/.env (never committed):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8)

default_platform(:ios)

platform :ios do
  # Auth only for lanes that talk to Apple — the local build lane needs none
  private_lane :asc_auth do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Regenerate the Xcode project and build a signed release archive"
  lane :build do
    sh("cd .. && xcodegen generate")
    # First run for a new bundle ID needs Apple's provisioning service to
    # register the App ID and mint an App Store profile; -allowProvisioningUpdates
    # authorizes xcodebuild to do that using the ASC API key.
    build_app(
      project: "stir.xcodeproj",
      scheme: "stir",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
              "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH')).shellescape}"
    )
  end

  desc "Upload a new build to TestFlight"
  lane :beta do
    asc_auth
    build
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Upload build + metadata to App Store Connect for review submission"
  lane :release do
    asc_auth
    build
    upload_to_app_store(
      force: true,                 # skip the HTML report prompt (non-interactive)
      precheck_include_in_app_purchases: false,
      submit_for_review: false     # Tim presses the final submit button
    )
  end

  desc "Push metadata (description, keywords, URLs) without a new build"
  lane :metadata do
    asc_auth
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
