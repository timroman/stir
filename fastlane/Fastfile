# stir — App Store automation
#
# Auth: create an App Store Connect API key (Users and Access → Integrations)
# and set these in fastlane/.env (never committed):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8)

default_platform(:ios)

platform :ios do
  # Auth only for lanes that talk to Apple — the local build lane needs none
  private_lane :asc_auth do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Regenerate the Xcode project and build a signed release archive"
  lane :build do
    sh("cd .. && xcodegen generate")
    # First run for a new bundle ID needs Apple's provisioning service to
    # register the App ID and mint an App Store profile; -allowProvisioningUpdates
    # authorizes xcodebuild to do that using the ASC API key.
    build_app(
      project: "stir.xcodeproj",
      scheme: "stir",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
              "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH')).shellescape}"
    )
  end

  # Note: the App Store Connect API cannot create app records (apps resource
  # is read/update only) — the one-time app creation is done in the ASC web UI.
  # Everything after that (builds, metadata, screenshots, TestFlight) works
  # through the API key.

  desc "Upload a new build to TestFlight"
  lane :beta do
    asc_auth
    build
    # Without a group a build processes, says it is in beta testing, and is
    # offered to nobody — which is how builds 12 through 20 sat unseen.
    upload_to_testflight(
      groups: ["Tim"],
      distribute_external: false,
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
  end

  # A build can process, report itself in beta testing, and still be offered to
  # nobody: internal testers only see builds attached to their group. Builds 12
  # through 20 sat unseen that way. This attaches the current build and sets its
  # what-to-test notes; `beta` does the same on upload.
  desc "Distribute the current build to the internal testers"
  lane :distribute do
    require "yaml"
    asc_auth
    versions = YAML.load_file("../project.yml")["settings"]["base"]
    upload_to_testflight(
      distribute_only: true,
      app_version: versions.fetch("MARKETING_VERSION").to_s,
      build_number: versions.fetch("CURRENT_PROJECT_VERSION").to_s,
      groups: ["Tim"],
      distribute_external: false,
      # Internal only: external testing would need a beta app description and
      # Apple's review, neither of which a one-person test flight wants
      skip_submission: true,
      changelog: File.read("metadata/testflight_notes.txt").strip
    )
  end

  desc "Upload build + metadata to App Store Connect (screenshots untouched)"
  lane :release do
    asc_auth
    build
    upload_to_app_store(
      force: true,                 # skip the HTML report prompt (non-interactive)
      # Screenshots are deliberately left alone. deliver verifies an upload
      # before App Store Connect has finished indexing the assets, concludes it
      # failed, and retries — but the retry deletes only the screenshots that
      # were still incomplete and re-uploads all of them, so every screenshot
      # that had already completed gains a duplicate. Pushing a build would
      # otherwise re-duplicate a set that was cleaned up by hand.
      # Use the `screenshots` lane for screenshots, then prune in App Store
      # Connect until this is fixed upstream.
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false     # Tim presses the final submit button
    )
  end

  # Known issue: deliver's post-upload verification races App Store Connect's
  # asset indexing and retries, leaving a duplicate of every screenshot that had
  # already completed. Check the set in App Store Connect after running this and
  # delete the extras by hand.
  desc "Replace the App Store screenshots only"
  lane :screenshots do
    asc_auth
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end


  # Sends the version that is already staged — build attached, metadata
  # uploaded — to review, without touching the binary or the screenshots.
  desc "Submit the staged version for App Review"
  lane :submit do
    asc_auth
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Push metadata (description, keywords, URLs) without a new build"
  lane :metadata do
    asc_auth
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
